rules_version = '2';

service cloud.firestore {
  function isOwner(userId) {
    return request.auth != null && request.auth.uid == userId;
  }

  function isAdmin() {
    return request.auth != null
      && request.auth.token.email == 'devildosti246@gmail.com'
      && request.auth.token.email_verified == true;
  }

  function customizationHasOrder(userId) {
    return 'orderId' in resource.data
      && resource.data.orderId is string
      && resource.data.orderId.size() > 0
      && exists(/databases/$(database)/documents/users/$(userId)/orders/$(resource.data.orderId));
  }

  function customizationHasOrderById(userId, customizationId) {
    let customizationPath = /databases/$(database)/documents/users/$(userId)/customizations/$(customizationId);
    let customization = get(customizationPath);
    return customization != null
      && 'orderId' in customization.data
      && customization.data.orderId is string
      && customization.data.orderId.size() > 0
      && exists(/databases/$(database)/documents/users/$(userId)/orders/$(customization.data.orderId));
  }

  function adminOrderUpdate() {
    return isAdmin()
      && (resource.data.status != 'Cancelled' || request.resource.data.status == 'Cancelled')
      && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', 'carrier', 'trackingNumber', 'trackingUrl', 'updatedAt']);
  }

  function customerCancelOrder(userId) {
    return isOwner(userId)
      && resource.data.status in ['Placed', 'Payment pending', 'Paid', 'Processing']
      && request.resource.data.status == 'Cancelled'
      && request.resource.data.cancelledAt == request.time
      && request.resource.data.updatedAt == request.time
      && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', 'cancelledAt', 'updatedAt']);
  }

  /* New orders start unpaid: a customer can't create an order already marked
     "Paid" or "Shipped". A payment reference is customer-submitted and must be
     verified by the store before an administrator changes the order to Paid. */
  function validNewOrder(userId, orderId) {
    return isOwner(userId)
      && request.resource.data.id == orderId
      && request.resource.data.status in ['Placed', 'Payment pending']
      && (!('paymentId' in request.resource.data) || request.resource.data.paymentId == '');
  }

  function validOrderAssetPath(userId, customizationId, assetName, path) {
    return path is string
      && path == 'firestore://' + userId + '/' + customizationId + '/' + assetName;
  }

  function validOrderCustomization(userId, orderId, customizationId) {
    let orderPath = /databases/$(database)/documents/users/$(userId)/orders/$(orderId);
    let files = request.resource.data.files;
    return isOwner(userId)
      && existsAfter(orderPath)
      && getAfter(orderPath).data.id == orderId
      && request.resource.data.id == customizationId
      && request.resource.data.orderId == orderId
      && request.resource.data.ownerUid == userId
      && files is map
      && files.keys().hasOnly(['mockup', 'details', 'preview', 'sourceModel'])
      && files.keys().hasAll(['mockup', 'details', 'preview'])
      && validOrderAssetPath(userId, customizationId, 'mockup', files.mockup)
      && validOrderAssetPath(userId, customizationId, 'details', files.details)
      && validOrderAssetPath(userId, customizationId, 'preview', files.preview)
      && (!('sourceModel' in files) || validOrderAssetPath(userId, customizationId, 'sourceModel', files.sourceModel));
  }

  function customerSubmitPaymentReference(userId) {
    return isOwner(userId)
      && resource.data.status == 'Payment pending'
      && request.resource.data.status == 'Payment pending'
      && request.resource.data.paymentId is string
      && request.resource.data.paymentId.size() > 0
      && request.resource.data.paymentId.size() <= 120
      && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['paymentId', 'updatedAt']);
  }

  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /customizations/{customizationId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        // Keep purchased design metadata and its file paths intact for fulfillment.
        allow update, delete: if isAdmin() || (isOwner(userId) && !customizationHasOrder(userId));

        match /assets/{assetName} {
          allow read: if isOwner(userId) || isAdmin();
          allow create, update: if isOwner(userId)
            && !customizationHasOrderById(userId, customizationId)
            && assetName in ['mockup', 'details', 'preview', 'sourceModel']
            && request.resource.data.uploadId is string
            && request.resource.data.uploadId.size() > 0
            && request.resource.data.uploadId.size() <= 100
            && request.resource.data.chunkCount is int
            && request.resource.data.chunkCount > 0
            && request.resource.data.chunkCount <= 150
            && request.resource.data.size is int
            && request.resource.data.size > 0
            && ((assetName == 'sourceModel' && request.resource.data.size <= 20971520)
              || (assetName != 'sourceModel' && request.resource.data.size <= 104857600))
            && request.resource.data.contentType is string
            && request.resource.data.contentType in ['model/gltf-binary', 'model/gltf+json', 'application/json', 'image/png', 'application/octet-stream'];
          allow delete: if isAdmin() || (isOwner(userId) && !customizationHasOrderById(userId, customizationId));

          match /chunks/{chunkId} {
            allow read: if isOwner(userId) || isAdmin();
            allow create, update: if isOwner(userId)
              && !customizationHasOrderById(userId, customizationId)
              && assetName in ['mockup', 'details', 'preview', 'sourceModel']
              && request.resource.data.uploadId is string
              && request.resource.data.uploadId.size() > 0
              && request.resource.data.uploadId.size() <= 100
              && request.resource.data.index is int
              && request.resource.data.index >= 0
              && request.resource.data.index < 150
              && request.resource.data.chunk is bytes
              && request.resource.data.chunk.size() <= 716800;
            allow delete: if isAdmin() || (isOwner(userId) && !customizationHasOrderById(userId, customizationId));
          }
        }
      }
    }

    match /users/{userId}/orders/{orderId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if validNewOrder(userId, orderId);
      // No delete: orders are business records. Customers cancel instead.
      allow update: if customerCancelOrder(userId)
        || customerSubmitPaymentReference(userId)
        || adminOrderUpdate();

      match /customizations/{customizationId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if validOrderCustomization(userId, orderId, customizationId);
        allow update, delete: if false;
      }
    }

    match /{path=**}/orders/{orderId} {
      allow read: if isAdmin();
      allow update: if adminOrderUpdate();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
