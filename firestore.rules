rules_version = '2';

service cloud.firestore {
  function isOwner(userId) {
    return request.auth != null && request.auth.uid == userId;
  }

  function isAdmin() {
    return request.auth != null
      && request.auth.token.email == 'devildosti246@gmail.com'
      && request.auth.token.email_verified == true;
  }

  function adminOrderUpdate() {
    return isAdmin()
      && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', 'carrier', 'trackingNumber', 'trackingUrl', 'updatedAt']);
  }

  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/orders/{orderId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, delete: if isOwner(userId);
      allow update: if isOwner(userId) || adminOrderUpdate();
    }

    match /{path=**}/orders/{orderId} {
      allow read: if isAdmin();
      allow update: if adminOrderUpdate();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
